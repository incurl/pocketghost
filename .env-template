# PocketHost environment template (Go / Docker-free)
#
# Every variable keeps the name the TypeScript deployment used, so an existing
# .env can be reused as-is. Copy to .env and adjust.

# development | production
NODE_ENV=development

# Apex domain served by this edge (instances live at <subdomain>.<apex>).
APEX_DOMAIN=pockethost.lvh.me

# http: in development, https: in production.
HTTP_PROTOCOL=http:

# Where all state lives. PH_HOME holds the control-plane database, TLS material
# and the PocketBase version cache; DATA_ROOT holds per-instance directories.
# PH_HOME=~/.local/share/pockethost
# DATA_ROOT=/var/lib/pockethost/data

# Public listener for the control plane (API + tenant proxy).
DAEMON_PORT=3000

# The mothership (the original control plane app) listens here on loopback.
MOTHERSHIP_PORT=8090

# Hibernate an instance after this much idle time (milliseconds, 0 disables).
DAEMON_PB_IDLE_TTL=5000

# Loopback port pool handed out to native PocketBase processes.
PH_INSTANCE_PORT_MIN=30000
PH_INSTANCE_PORT_MAX=40000

# OS-level per-instance limits (replaces container limits).
PH_INSTANCE_MEMORY_MB=128
PH_INSTANCE_CPU_PERCENT=50
PH_INSTANCE_NOFILE=8192

# PocketBase versions
PH_POCKETBASE_ROOT=/var/lib/pockethost/pocketbase
PH_ALLOWED_POCKETBASE_SEMVER=<1.0.0

# Mothership (control-plane) integration
MOTHERSHIP_NAME=mothership
MOTHERSHIP_ADMIN_USERNAME=
MOTHERSHIP_ADMIN_PASSWORD=

# Shared secret for internal daemon APIs (rate-limit bypass, vacuum, backups).
# Development defaults to "dev".
PH_SECRET=

# Stable edge identity for fleet stats.
PH_EDGE_ID=
PH_EDGE_REGION=sfo
PH_EDGE_INTERNAL_URL=

# TLS: development self-signed, production ACME (Let's Encrypt).
PH_TLS_ACME=false
PH_TLS_EMAIL=
# SSL_KEY=~/.local/share/pockethost/ssl/tls.key
# SSL_CERT=~/.local/share/pockethost/ssl/tls.cert

# Firewall
IPCIDR_LIST=
PH_ENABLE_FIREWALL_RATE_LIMIT=0
PH_FIREWALL_DAEMON_GRACE_MS=60000
PH_FIREWALL_DAEMON_GRACE_RETRY_MS=500

# Backups
PH_BACKUP_ROOT=
PH_BACKUP_RETAIN=7
PH_BACKUP_CRON=0 3 * * *

# FTP / SFTP
PH_FTP_PORT=21
PH_FTP_PASV_IP=127.0.0.1
PH_FTP_PASV_PORT_MIN=10000
PH_FTP_PASV_PORT_MAX=20000
PH_SFTP_PORT=2222

# Set to a PocketBase binary path to pin every tenant to one build
# (integration tests and single-version appliances).
# PH_INSTANCE_BINARY=/usr/local/bin/pocketbase

# Mount the bundled instance-app hooks/migrations into each instance workdir.
# PH_INSTANCE_APP_ROOT=/opt/pockethost/instance-app
